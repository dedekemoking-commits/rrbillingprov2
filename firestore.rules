rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All requests must be authenticated
    function isAuth() { return request.auth != null; }
    
    // Check if the requesting user is a super admin
    // The admin's Firebase Auth UID must exist as a document in /admins/{uid}
    // with field isAdmin == true
    function isSuperAdmin() {
      return isAuth() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // Validasi pemilik rental dari dokumen indeks _user_<username>.
    // Path harus memakai satu segmen utuh, bukan "_user_$(username)".
    function isRentalOwner(username) {
      let userId = '_user_' + username;
      return get(/databases/$(database)/documents/billingps_users/$(userId)).data.email.lower()
        == request.auth.token.email.lower()
        && get(/databases/$(database)/documents/billingps_users/$(userId)).data.role in ["admin", "owner"];
    }

    // Licenses collection
    match /licenses/{docId} {
      // Anyone authenticated can read licenses (for activation lookup)
      allow read: if isAuth();
      // Admin (RR Lisensi) creates/updates licenses; app signs in anonymously so can't use UID check
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // Invoices collection
    match /invoices/{docId} {
      // Anyone authenticated can read invoices (user invoices + admin license generator)
      allow read: if isAuth();
      // Users can create invoices; username is the app-internal username, not auth UID
      allow create: if isAuth();
      // Admin (RR Lisensi) confirms invoices; app signs in anonymously so can't use UID check
      allow update: if isAuth();
      allow delete: if false;
    }

    // Notifications collection
    match /notifications/{docId} {
      // Anyone authenticated can read and create notifications
      allow read: if isAuth();
      allow create: if isAuth();
      // Admin (RR Lisensi) marks requests as read
      allow update: if isAuth();
      allow delete: if false;
    }

    // BillingPS Users collection — one document per username
    match /billingps_users/{username} {
      // Anyone authenticated can read user docs (for license lookup etc.)
      allow read: if isAuth();
      // Users can only write to their own document
      // For now: require auth. In future: require request.auth.uid == username mapping
      allow write: if isAuth();

      // tvCommands subcollection — TV client heartbeat + billing + monitor commands
      match /tvCommands/{tvId} {
        allow read, write: if isAuth();
      }

      // stockOpnames subcollection — opname stok F&B dari RR Owner
      match /stockOpnames/{opnameId} {
        allow read: if isAuth();
        allow create: if isAuth()
          && request.resource.data.status == "pending"
          && request.resource.data.rentalUsername == username
          && request.resource.data.submittedByUid == request.auth.uid
          && request.resource.data.submittedByEmail == request.auth.token.email
          && request.resource.data.items is list
          && isRentalOwner(username);
        // Aplikasi billing menandai opname sebagai applied setelah stok lokal diperbarui
        allow update: if isAuth();
        allow delete: if false;
      }

      // cashDrawerRequests subcollection — permintaan tarik uang laci dari RR Owner
      match /cashDrawerRequests/{requestId} {
        allow read: if isAuth();
        allow create: if isAuth()
          && request.resource.data.status == "pending"
          && request.resource.data.rentalUsername == username
          && request.resource.data.submittedByUid == request.auth.uid
          && request.resource.data.submittedByEmail == request.auth.token.email
          && request.resource.data.nominal is int
          && request.resource.data.nominal > 0
          && isRentalOwner(username);
        // Aplikasi billing menandai request sebagai applied/rejected setelah diproses
        allow update: if isAuth();
        allow delete: if false;
      }

      // fnbItemRequests subcollection - item F&B baru/edit harga dari RR Owner
      match /fnbItemRequests/{requestId} {
        allow read: if isAuth();
        allow create: if isAuth()
          && request.resource.data.status == "pending"
          && request.resource.data.rentalUsername == username
          && request.resource.data.submittedByUid == request.auth.uid
          && request.resource.data.submittedByEmail == request.auth.token.email
          && (
            !request.resource.data.keys().hasAny(["action"])
              || request.resource.data.action in ["add", "update"]
          )
          && request.resource.data.category in ["makanan", "minuman"]
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.price is int
          && request.resource.data.price >= 0
          && request.resource.data.initialStock is int
          && request.resource.data.initialStock >= 0
          && isRentalOwner(username);
        // Aplikasi billing menandai request applied/rejected setelah diproses
        allow update: if isAuth();
        allow delete: if false;
      }

      // packageRequests subcollection - tambah/edit paket sesi dari RR Owner
      match /packageRequests/{requestId} {
        allow read: if isAuth();
        allow create: if isAuth()
          && request.resource.data.status == "pending"
          && request.resource.data.rentalUsername == username
          && request.resource.data.submittedByUid == request.auth.uid
          && request.resource.data.submittedByEmail == request.auth.token.email
          && request.resource.data.action in ["add", "update"]
          && request.resource.data.groupName is string
          && request.resource.data.groupName.size() > 0
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.price is int
          && request.resource.data.price >= 0
          && request.resource.data.durationMinutes is int
          && request.resource.data.durationMinutes >= 0
          && isRentalOwner(username);
        // Aplikasi billing menandai request applied/rejected setelah diproses
        allow update: if isAuth();
        allow delete: if false;
      }

      // groupRequests subcollection - grup PS baru dari RR Owner
      match /groupRequests/{requestId} {
        allow read: if isAuth();
        allow create: if isAuth()
          && request.resource.data.status == "pending"
          && request.resource.data.rentalUsername == username
          && request.resource.data.submittedByUid == request.auth.uid
          && request.resource.data.submittedByEmail == request.auth.token.email
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && isRentalOwner(username);
        // Aplikasi billing menandai request applied/rejected setelah diproses
        allow update: if isAuth();
        allow delete: if false;
      }

      // tvLogs subcollection — TV logcat reports uploaded by the billing app
      match /tvLogs/{tvId} {
        allow read, write: if isAuth();

        match /reports/{reportId} {
          allow read, write: if isAuth();
        }
      }
    }

    // BillingPS Devices collection — one document per device
    match /billingps_devices/{deviceId} {
      // Devices read/write by authenticated users
      // Restrict to device owner when UID is known
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Owner account mapping: Firebase Auth UID -> rental username.
    // Only the signed-in owner can read/write their own mapping.
    match /owner_accounts/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow write: if isAuth()
        && request.auth.uid == uid
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.rentalUsername is string;
    }

    // Global settings
    match /settings/{docId} {
      // Anyone authenticated can read settings
      allow read: if isAuth();
      // Only super admin can modify settings
      allow write: if isSuperAdmin();
    }

    // Admins collection — stores admin UIDs
    match /admins/{userId} {
      // Anyone authenticated can read (to check if someone is admin)
      allow read: if isAuth();
      // Only the admin themselves or another super admin can write
      allow write: if isSuperAdmin() || request.auth.uid == userId;
    }
  }
}
